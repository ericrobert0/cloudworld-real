{
  "name": "CloudWorld — execução real",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "remoteUser": "node",
  "postCreateCommand": "node scripts/Configure-CodespacesDocker.mjs && npm ci --ignore-scripts",
  "postStartCommand": "node scripts/Start-CodespacesPanels.mjs",
  "customizations": {
    "vscode": {
      "settings": { "remote.autoForwardPorts": false }
    }
  }
}
